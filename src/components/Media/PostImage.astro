---
/**
 * Post cover, on the listing cards and at the top of a post.
 *
 * Responsive candidates are generated from the asset; `sizes` matches the rendered width of
 * each placement (a ~340px card, a ~720px post header). `priority` marks the cover that is
 * the largest element of the first screen: it loads eagerly, first in the queue, and is
 * decoded before paint. The container carries a skeleton background until the image is in.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  variant?: 'card' | 'hero';
  priority?: boolean;
  class?: string;
}

const { src, alt, variant = 'card', priority = false, class: className = '' } = Astro.props;

const sizes =
  variant === 'hero'
    ? '(min-width: 768px) 720px, calc(100vw - 48px)'
    : '(min-width: 768px) 340px, calc(100vw - 48px)';
---

<div class:list={['relative aspect-[3/2] w-full overflow-hidden rounded-t-2xl skeleton', className]}>
  <Image
    src={src}
    alt={alt}
    widths={[400, 800, 1200, 1536]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding={priority ? 'sync' : 'async'}
    class="absolute inset-0 w-full h-full object-cover group-hover:scale-105"
    style="transition: transform 0.3s ease-in-out;"
  />
</div>

<script>
  // Drop the pulsing placeholder once each cover has arrived (or failed), so the animation
  // does not keep running underneath a loaded image.
  document.querySelectorAll<HTMLImageElement>('.skeleton > img').forEach((img) => {
    const settle = () => img.parentElement?.classList.remove('skeleton');
    if (img.complete) settle();
    else {
      img.addEventListener('load', settle, { once: true });
      img.addEventListener('error', settle, { once: true });
    }
  });
</script>

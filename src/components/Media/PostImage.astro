---
/**
 * Post cover, on the listing cards and at the top of a post.
 *
 * Responsive candidates are generated from the asset; `sizes` matches the rendered width of
 * each placement (a card up to 476px, a ~736px post header). The container carries a skeleton
 * background until the image is in, and a lazy cover that arrives later fades in over it.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  variant?: 'card' | 'hero';
  /**
   * - `priority`: the largest element of the first screen. First in the queue, decoded before paint.
   * - `eager`: also on the first screen, without competing with it.
   * - `lazy`: loads as it nears the screen.
   */
  load?: 'priority' | 'eager' | 'lazy';
  class?: string;
}

const { src, alt, variant = 'card', load = 'lazy', class: className = '' } = Astro.props;
const priority = load === 'priority';

const sizes =
  variant === 'hero'
    ? '(min-width: 768px) 736px, calc(100vw - 32px)'
    : '(min-width: 1024px) 476px, (min-width: 768px) calc(50vw - 36px), calc(100vw - 32px)';
---

<div class:list={['post-image relative aspect-[3/2] w-full overflow-hidden rounded-t-2xl skeleton', className]}>
  <Image
    src={src}
    alt={alt}
    widths={[400, 800, 1200, 1536]}
    sizes={sizes}
    loading={load === 'lazy' ? 'lazy' : 'eager'}
    fetchpriority={priority ? 'high' : undefined}
    decoding={priority ? 'sync' : 'async'}
    class="post-image__img absolute inset-0 w-full h-full object-cover motion-safe:group-hover:scale-105"
  />
</div>

<style>
  /* The placeholder fades out as the cover fades in: dropped at once, it would leave a dark gap
     under the first frames of the fade. */
  .post-image {
    transition: background-color 0.3s ease-out;
  }

  .post-image__img {
    transition:
      transform 0.3s ease-in-out,
      opacity 0.3s ease-out;
  }

  .post-image__img.is-pending {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-image,
    .post-image__img {
      transition: none;
    }
  }
</style>

<script>
  // Drop the placeholder once each cover has arrived (or failed), so nothing paints underneath a
  // loaded image. Only a lazy cover still on its way is hidden for the fade: the script sets it, so
  // without JavaScript every cover shows, and an eager one must paint as soon as it can.
  document.querySelectorAll<HTMLImageElement>('.skeleton > img').forEach((img) => {
    const settle = () => {
      img.parentElement?.classList.remove('skeleton');
      img.classList.remove('is-pending');
    };
    if (img.complete) settle();
    else {
      if (img.loading === 'lazy') img.classList.add('is-pending');
      img.addEventListener('load', settle, { once: true });
      img.addEventListener('error', settle, { once: true });
    }
  });
</script>

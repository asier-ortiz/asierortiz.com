---
import NavLink from '@components/Nav/NavLink.astro';
import MobileNav from '@components/Nav/MobileNav.astro';
import SiteLogo from '@components/SiteLogo/SiteLogo.astro';
import Button from '@components/Button/Button.astro';
import navData from '@config/navData.json';
import siteData from '@config/siteData.json.ts';
---

<div
  id="nav__container"
  class="fixed left-0 top-0 z-30 flex w-full flex-col bg-base-900/70 backdrop-blur-md py-1 duration-500"
  transition:name={`nav`}
>
  <div class="mx-auto flex w-full">
    <div class="container flex h-16 w-full items-center">
      <header class="flex w-full items-center gap-2">
        <div class="flex flex-auto justify-start">
          <SiteLogo />
        </div>
        <div class="flex flex-auto justify-end">
          <nav class="hidden md:block">
            <ul class="flex h-fit items-center px-4">
              {navData.map((navItem) => <NavLink navItem={navItem} />)}
            </ul>
          </nav>
          <Button
            variant="primary"
            class="my-auto min-h-10 px-4 text-sm md:px-5 md:text-base"
            href={`mailto:${siteData.author.email}`}
          >
            Contact
          </Button>
          <div class="ml-3 md:hidden">
            <MobileNav />
          </div>
        </div>
      </header>
    </div>
  </div>
</div>

<script>
  // Scroll-spy for the logo and the section links, header and drawer alike: underlines the link
  // of the section in view. Pages without section[id] keep their server-rendered underline.
  function highlightNavLink() {
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('[data-section] span');

    if (!sections.length) return;

    let index = sections.length;
    while (--index && window.scrollY + 30 < sections[index].offsetTop) {}

    navLinks.forEach((link) => link.classList.remove('active-navlink'));

    if (sections[index]) {
      const activeSection = sections[index].id;
      document
        .querySelectorAll(`[data-section="${activeSection}"] span`)
        .forEach((link) => link.classList.add('active-navlink'));
    }
  }

  highlightNavLink();
  window.addEventListener('load', highlightNavLink);
  window.addEventListener('scroll', highlightNavLink);

  // A nav link to the page already open (the logo on /, '/ blog' on /blog/) scrolls back to the
  // top instead of reloading it. Links to a #section keep the browser's own jump.
  document.getElementById('nav__container').addEventListener('click', (event) => {
    if (event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = event.target.closest('a[href]');
    if (!link || link.hash || link.target || link.href !== location.href.split('#')[0]) return;

    event.preventDefault();
    history.replaceState(history.state, '', link.href); // drops a #section left in the address
    window.scrollTo({ top: 0 }); // html's scroll-behavior makes it smooth unless reduced motion
  });
</script>

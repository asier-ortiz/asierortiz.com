---
import { Icon } from 'astro-icon/components';
import NavLink from '@components/Nav/NavLink.astro';
import navData from '@config/navData.json';
---

<div id="mobile-nav__container">
  <button
    id="mobile-nav__burger"
    aria-label="open navigation menu"
    aria-controls="mobile-nav__content"
    aria-expanded="false"
    class="primary-focus h-10 w-10 rounded-md"
  >
    <Icon
      name="tabler-menu-2"
      class="m-auto inline-block h-8 w-8 stroke-current"
      aria-hidden="true"
    />
  </button>
  <!-- touch-none here and on the backdrop keeps a swipe over the open drawer from scrolling the
       page behind; overflow: hidden on body does not stop it on iOS (WebKit bug 240859). -->
  <div
    id="mobile-nav__content"
    class="whitespace-nowrap fixed -right-72 top-0 z-40 hidden h-screen w-72 touch-none items-center overflow-x-hidden bg-base-900 text-lg font-normal transition-all duration-300"
  >
    <div class="w-full px-2">
      <div class="mx-1 my-2 flex w-full justify-end pl-6 pr-4">
        <button id="mobile-nav__close" class="primary-focus p-2" aria-label="close navigation menu">
          <Icon name="tdesign:close" class="h-8 w-8" aria-hidden="true" />
        </button>
      </div>
      <hr class="mx-5 border-b-2 border-base-600" />
      <nav aria-label="Main">
        <ul class="mx-1 mt-2 text-xl">
          {
            navData.map((navItem) => <NavLink navItem={navItem} />)
          }
        </ul>
      </nav>
    </div>
  </div>
  <!-- For the finger and the mouse: keyboards close with Escape or the close button, so the
       backdrop stays out of the tab order and the accessibility tree. -->
  <button
    id="mobile-nav__backdrop"
    class="mobile-nav__backdrop--fade-out fixed left-0 top-0 z-30 h-screen touch-none bg-black"
    tabindex="-1"
    aria-hidden="true"></button>
</div>

<style lang="scss">
  .mobile-nav__backdrop--fade-in {
    animation: MobileNavFadeInAnimation ease-in-out 0.3s forwards;
    @apply block w-screen;
  }

  .mobile-nav__backdrop--fade-out {
    @apply hidden w-0 opacity-0;
  }

  @keyframes MobileNavFadeInAnimation {
    0% {
      @apply opacity-0;
    }
    100% {
      @apply opacity-40;
    }
  }

  .mobile-nav--slide-in {
    animation: mobileNavSlideInAnimation ease-in-out 0.3s forwards;
  }

  .mobile-nav--slide-out {
    animation: mobileNavSlideOutAnimation ease-in-out 0.3s forwards;
  }

  @keyframes mobileNavSlideInAnimation {
    0% {
      @apply -right-72;
    }
    100% {
      @apply right-0;
    }
  }

  @keyframes mobileNavSlideOutAnimation {
    0% {
      @apply right-0;
    }
    100% {
      @apply -right-72;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-nav__content {
      /* The open position lives in animation-fill-mode: forwards, and the
         element's transition-all would animate the pinned `right` change. */
      @apply transition-none;

      &.mobile-nav--slide-in {
        animation: none;
        @apply right-0;
      }

      &.mobile-nav--slide-out {
        animation: none;
        @apply -right-72;
      }
    }

    .mobile-nav__backdrop--fade-in {
      animation: none;
      @apply opacity-40;
    }
  }
</style>

<script>
  let mobileNavContainer;
  let mobileNavBurger;
  let mobileNavContent;
  let mobileNavCloseBtn;
  let mobileNavBackdrop;
  let hideContentTimeout;
  let pageBehind = [];

  // Everything but the drawer and its backdrop: the siblings met on the way from the drawer up to
  // body, so the header around it is covered too.
  function outsideDrawer() {
    const outside = [];
    for (let el = mobileNavContent; el !== document.body; el = el.parentElement) {
      for (const sibling of el.parentElement.children) {
        if (sibling !== el && sibling !== mobileNavBackdrop && !sibling.inert) {
          outside.push(sibling);
        }
      }
    }
    return outside;
  }

  function toggleMobileNav(event) {
    if (mobileNavBurger && mobileNavContent && mobileNavContainer && mobileNavBackdrop) {
      if (!mobileNavContainer.classList.contains('open')) {
        mobileNavContainer.classList.add('open');
        mobileNavBurger.setAttribute('aria-expanded', 'true');

        // A close scheduled this hide; reopening within its 300ms must cancel
        // it or the open drawer gets display:none under a live backdrop.
        clearTimeout(hideContentTimeout);
        mobileNavContent.classList.remove('hidden');
        mobileNavContent.classList.remove('mobile-nav--slide-out');
        mobileNavContent.classList.add('mobile-nav--slide-in');

        mobileNavBackdrop.classList.remove('hidden');
        mobileNavBackdrop.classList.remove('mobile-nav__backdrop--fade-out');
        mobileNavBackdrop.classList.add('mobile-nav__backdrop--fade-in');

        // Modal while open, like the search dialog: focus moves in and the page behind is inert,
        // so Tab and screen readers stay in the drawer (WCAG 2.4.3). Safari before 15.5 ignores
        // inert and lets Tab out.
        mobileNavCloseBtn.focus({ preventScroll: true });
        pageBehind = outsideDrawer();
        pageBehind.forEach((el) => (el.inert = true));
      } else {
        closeMobileNav({ returnFocus: true });
      }

      event.preventDefault();
    }
  }

  // No preventDefault: link clicks and page events call this too, and their default must run.
  // Focus goes back to the burger only when the drawer itself was dismissed (close button,
  // backdrop, Escape): a link takes it to its own target.
  function closeMobileNav({ animate = true, returnFocus = false } = {}) {
    if (mobileNavContent.classList.contains('hidden')) return;

    mobileNavContainer.classList.remove('open');
    mobileNavBurger.setAttribute('aria-expanded', 'false');

    pageBehind.forEach((el) => (el.inert = false));
    pageBehind = [];
    if (returnFocus) mobileNavBurger.focus({ preventScroll: true });

    mobileNavContent.classList.remove('mobile-nav--slide-in');
    clearTimeout(hideContentTimeout);
    if (animate) {
      mobileNavContent.classList.add('mobile-nav--slide-out');
      hideContentTimeout = setTimeout(() => {
        mobileNavContent.classList.add('hidden');
      }, 300);
    } else {
      mobileNavContent.classList.add('hidden');
    }

    mobileNavBackdrop.classList.remove('mobile-nav__backdrop--fade-in');
    mobileNavBackdrop.classList.add('mobile-nav__backdrop--fade-out');
  }

  function initMobileNav() {
    if (typeof window !== 'undefined') {
      mobileNavContainer = document.getElementById('mobile-nav__container');
      mobileNavBurger = document.getElementById('mobile-nav__burger');
      mobileNavContent = document.getElementById('mobile-nav__content');
      mobileNavCloseBtn = document.getElementById('mobile-nav__close');
      mobileNavBackdrop = document.getElementById('mobile-nav__backdrop');

      if (mobileNavBurger && mobileNavContent && mobileNavCloseBtn && mobileNavBackdrop) {
        mobileNavBurger.addEventListener('click', toggleMobileNav);
        mobileNavCloseBtn.addEventListener('click', toggleMobileNav);
        mobileNavBackdrop.addEventListener('click', toggleMobileNav);

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && mobileNavContainer.classList.contains('open')) {
            closeMobileNav({ returnFocus: true });
          }
        });

        // A link into this same page (Background or Projects on /) never unloads it, so nothing
        // else would close the drawer.
        mobileNavContent.addEventListener('click', (event) => {
          const link = event.target.closest('a[href]');
          if (link && link.href.split('#')[0] === location.href.split('#')[0]) closeMobileNav();
        });

        // The back/forward cache restores the page as it was left: close the drawer on the way
        // out, and again on return in case a browser restored it before pagehide ran.
        window.addEventListener('pagehide', () => closeMobileNav({ animate: false }));
        window.addEventListener('pageshow', (event) => {
          if (event.persisted) closeMobileNav({ animate: false });
        });

        // Nav.astro hides the drawer from md (768px) up. Rotating there closes it, instead of
        // leaving it open out of sight to reappear and replay its entrance on the way back.
        window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
          if (event.matches) closeMobileNav({ animate: false });
        });
      }
    }
  }

  document.addEventListener('DOMContentLoaded', initMobileNav);
</script>

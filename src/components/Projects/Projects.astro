---
import ProjectCard from '@components/Projects/ProjectCard.astro';
import projectData from '@config/projectData.json';
import Code from '@components/Icons/Code.astro';
import Button from '@components/Button/Button.astro';
---

<!-- -scroll-mt-24 cancels the root's scroll-padding-top (global.scss): the top padding below
     already clears the fixed header, so /#projects keeps landing with the section at the top. -->
<section id="projects" class="w-full pb-6 -scroll-mt-24" data-aos="fade-up">
  <div class="container pt-24 md:pt-36 lg:pt-44">
    <div class="mx-auto max-w-lg md:max-w-full md:col-span-2">
      <h2 class="h2 flex items-center">
        <Code class="mr-2 size-10 description" />
        <span>A selection of my <span class="text-gradient">projects.</span></span>
      </h2>
    </div>
    <div class="mx-auto mt-10 max-w-lg md:mt-10 md:max-w-full min-h-[600px]">
      <!-- aria-pressed drives the selected look. The press is grey, so a thumb resting on a filter
           while scrolling never looks like a selection. Narrower sides on phones keep the three
           on one line from 360px wide. -->
      <div class="flex flex-wrap gap-2">
        <Button
          variant="ghost"
          class="filter-button px-3.5 sm:px-5 active:bg-base-600 active:text-base-100 aria-pressed:bg-primary-500 aria-pressed:text-white"
          aria-pressed="true"
          data-filter="all">All</Button
        >
        <Button
          variant="ghost"
          class="filter-button px-3.5 sm:px-5 active:bg-base-600 active:text-base-100 aria-pressed:bg-primary-500 aria-pressed:text-white"
          aria-pressed="false"
          data-filter="mobile & web development">Web & Mobile</Button
        >
        <Button
          variant="ghost"
          class="filter-button px-3.5 sm:px-5 active:bg-base-600 active:text-base-100 aria-pressed:bg-primary-500 aria-pressed:text-white"
          aria-pressed="false"
          data-filter="data science & machine learning">Data & ML</Button
        >
      </div>
      <!-- The zoom grows from the top edge: from the centre, a grid this tall starts with its
           first row about 490px below where it lands. -->
      <div data-aos="zoom-in-up" class="grid gap-x-4 gap-y-8 md:grid-cols-2 mt-6 origin-top">
        {
          projectData.map((project) => (
            <ProjectCard {...project} />
          ))
        }
      </div>
      <div
        id="no-projects-message"
        class="hidden mt-6 text-center text-base-500 text-xl font-semibold h-32 flex items-center justify-center"
      >
        Coming soon! New projects in development. Stay tuned!
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.filter-button');
    const projectCards = document.querySelectorAll('.project-card');
    const noProjectsMessage = document.getElementById('no-projects-message');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');
        let hasProjects = false;

        projectCards.forEach((card) => {
          const types = card.getAttribute('data-type')?.split(',') || [];
          if (filter === 'all' || types.includes(filter)) {
            card.style.display = '';
            hasProjects = true;
          } else {
            card.style.display = 'none';
          }
        });

        if (!hasProjects) {
          noProjectsMessage.classList.remove('hidden');
        } else {
          noProjectsMessage.classList.add('hidden');
        }

        buttons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn === button)));
      });
    });
  });
</script>

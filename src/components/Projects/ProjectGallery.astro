---
/**
 * Image gallery for a project card.
 *
 * Renders the frames stacked on top of each other and cross-fades between them
 * while the gallery is on screen. With a single frame it is a plain image.
 * The rotation is skipped when the visitor prefers reduced motion or when site
 * animations are disabled (the `use-animations` class on <body>, same rule AOS uses).
 * While it rotates, a switch in the corner pauses it until switched back (WCAG 2.2.2
 * asks for a way to stop content that moves on its own); a mouse over the gallery only
 * holds it while there.
 *
 * Every gallery is a 4:3 box and the frames cover it, so the cards in a grid row keep
 * their images the same height whatever the screenshots' own proportions are. The
 * screenshots are device mockups with wide margins, so the crop only takes background.
 *
 * The first frame loads eagerly so the gallery is complete when the visitor reaches it,
 * but at low priority so it never competes with the hero, fonts and CSS. Candidates are
 * sized to the rendered card (measured 322px on phones, 452px on desktop).
 */
import { Image } from 'astro:assets';
import PauseSwitch from '@components/Button/PauseSwitch.astro';
import type { GalleryFrame } from '@config/projectData.json';

interface Props {
  images: GalleryFrame[];
  /** Must be unique per page: it feeds the pause switch id. */
  id: string;
  /** Milliseconds each frame stays visible. */
  interval?: number;
  class?: string;
}

const { images, id, interval = 7000, class: className = '' } = Astro.props;
---

<div class:list={['project-gallery', className]} data-interval={interval} aria-live="off">
  {
    images.map((image, index) => (
      <Image
        class:list={['project-gallery__frame', { 'is-active': index === 0 }]}
        src={image.src}
        alt={image.alt}
        aria-hidden={index === 0 ? undefined : 'true'}
        width={960}
        widths={[480, 720, 960, 1440]}
        sizes="(min-width: 1024px) 452px, (min-width: 768px) 42vw, 83vw"
        loading={index === 0 ? 'eager' : 'lazy'}
        fetchpriority={index === 0 ? 'low' : undefined}
        decoding={index === 0 ? 'auto' : 'async'}
      />
    ))
  }
  {/* Hidden until the script sets up the rotation, the only case where anything moves. */}
  {
    images.length > 1 && (
      <PauseSwitch
        id={`${id}-pause`}
        label="Pause slideshow"
        variant="overlay"
        class="absolute bottom-2 right-2"
        hidden
      />
    )
  }
</div>

<style>
  .project-gallery {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.25rem;
    transition: transform 0.4s ease-in-out;
  }

  .project-gallery.zoom {
    transform: scale(1.02);
  }

  .project-gallery__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }

  .project-gallery__frame.is-active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-gallery,
    .project-gallery__frame {
      transition: none;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function setupGallery(gallery: HTMLElement) {
    const frames = Array.from(gallery.querySelectorAll<HTMLElement>('.project-gallery__frame'));
    const pauseSwitch = gallery.querySelector<HTMLInputElement>('.pause-switch__input');
    if (frames.length < 2 || !pauseSwitch) return;
    if (reducedMotion.matches || !document.body.classList.contains('use-animations')) return;

    const interval = Number(gallery.dataset.interval) || 7000;
    let index = 0;
    let timer: number | undefined;
    let visible = false;
    let hovered = false;

    // Only the visible frame is exposed to assistive tech; the stacked ones stay hidden.
    const show = (next: number) => {
      frames[index].classList.remove('is-active');
      frames[index].setAttribute('aria-hidden', 'true');
      index = next;
      frames[index].classList.add('is-active');
      frames[index].removeAttribute('aria-hidden');
    };

    // Rotate only while the card is on screen in a visible tab and nothing holds it: the pause
    // switch, a mouse over the gallery, or reduced motion turned on mid-visit.
    const sync = () => {
      const rotate =
        visible && !hovered && !pauseSwitch.checked && !document.hidden && !reducedMotion.matches;
      if (rotate && timer === undefined) {
        timer = window.setInterval(() => show((index + 1) % frames.length), interval);
      } else if (!rotate && timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        sync();
      },
      { threshold: 0.4 }
    ).observe(gallery);

    // Mouse only: touch has no hover to hold the rotation with.
    gallery.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse') return;
      hovered = true;
      sync();
    });
    gallery.addEventListener('pointerleave', () => {
      hovered = false;
      sync();
    });
    pauseSwitch.addEventListener('change', sync);
    reducedMotion.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);

    pauseSwitch.closest<HTMLElement>('.pause-switch')?.removeAttribute('hidden');
  }

  document.querySelectorAll<HTMLElement>('.project-gallery').forEach(setupGallery);
</script>

---
import PauseSwitch from '@components/Button/PauseSwitch.astro';
import StackMarqueeItem from '@components/Stack/StackMarqueeItem.astro';
import { type StackItem } from '@config/stackData.json';

interface Props {
  items: StackItem[];
  title?: string;
  /** Must be unique per page: it feeds the heading id and the pause switch id. */
  id?: string;
  /** Seconds per item, so the speed stays constant when the list grows. */
  secondsPerItem?: number;
  class?: string;
}

const {
  items,
  title = 'Technologies I work with',
  id = 'stack-marquee',
  secondsPerItem = 3.5,
  class: className,
} = Astro.props as Props;

const duration = `${items.length * secondsPerItem}s`;
---

<!--
  Seamless loop: the track holds two identical copies and translates by -50%,
  so the last frame equals the first. One copy must be wider than the viewport.
  The second copy is aria-hidden and removed entirely under prefers-reduced-motion.
-->
<section
  class:list={['stack-marquee flex items-center gap-2', className]}
  aria-labelledby={`${id}-title`}
>
  <h2 id={`${id}-title`} class="sr-only">{title}</h2>
  <div class="stack-marquee__viewport flex h-8 min-w-0 flex-1 items-center">
    <div class="stack-marquee__track" style={`--marquee-duration: ${duration}`}>
      <ul role="list" class="stack-marquee__list">
        {items.map((item) => <StackMarqueeItem {...item} />)}
      </ul>
      <ul role="list" class="stack-marquee__list" aria-hidden="true">
        {items.map((item) => <StackMarqueeItem {...item} />)}
      </ul>
    </div>
  </div>
  <PauseSwitch id={`${id}-pause`} class="shrink-0" />
</section>

<style lang="scss">
  .stack-marquee {
    --marquee-gap: 2.5rem;
    --marquee-fade: 3rem;
  }

  .stack-marquee__viewport {
    overflow: hidden;
    overflow: clip; /* not a scroll container, so scrollIntoView() can never offset the track */
    /* Own compositing layer, so WebKit applies the mask per frame instead of
       leaving a software-masked subtree that a moving child does not repaint. */
    will-change: transform;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--marquee-fade),
      #000 calc(100% - var(--marquee-fade)),
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--marquee-fade),
      #000 calc(100% - var(--marquee-fade)),
      transparent
    );
  }

  .stack-marquee__track {
    display: flex;
    width: max-content;
    /* Longhands on purpose: Safari can fail to start an animation whose
       shorthand contains var() and only pick it up on a later style recalc,
       which showed as a frozen strip on first load that a reload "fixed". */
    animation-name: stack-marquee-scroll;
    animation-duration: var(--marquee-duration, 90s);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .stack-marquee__list {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--marquee-gap);
    padding-right: var(--marquee-gap);
  }

  @keyframes stack-marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .stack-marquee:hover .stack-marquee__track {
      animation-play-state: paused;
    }
  }

  /* :has() reads the switch wherever it sits; :global() because its checkbox belongs to
     PauseSwitch.astro, outside this component's scope. */
  :global(.stack-marquee:has(.pause-switch__input:checked)) .stack-marquee__track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-marquee__viewport {
      height: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .stack-marquee__track {
      width: 100%;
      animation: none;
    }

    .stack-marquee__list {
      flex: auto;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 0.75rem;
      padding-right: 0;
    }

    .stack-marquee__list[aria-hidden='true'] {
      display: none;
    }
  }
</style>

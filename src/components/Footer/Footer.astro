---
import SocialCloud from '@components/Social/SocialCloud.astro';
import siteData from '@config/siteData.json';
const today = new Date();
---

<footer class="container mb-12 mt-20">
  <hr class="border-t-2 border-t-base-600" />
  <div class="mt-4 flex w-full flex-wrap items-center justify-between gap-x-8 gap-y-2">
    <div class="flex items-center">
      <SocialCloud />
    </div>
    <!-- The 20px-tall text links reach a 40px tap area through ::before. -->
    <div class="description font-sans text-sm">
      &copy; {today.getFullYear()}
      {' '}{siteData.name}. All rights reserved.
      <span aria-hidden="true" class="mx-1">·</span>
      <a
        href={`mailto:${siteData.author.email}`}
        class="primary-focus relative underline decoration-base-600 underline-offset-4 hover:text-base-200 hover:decoration-primary-400 active:text-base-200 active:decoration-primary-400 before:absolute before:-inset-x-1 before:-inset-y-2.5 before:content-['']"
        >{siteData.author.email}</a
      >
      <span aria-hidden="true" class="mx-1">·</span>
      <a
        href="/privacy/"
        class="primary-focus relative underline decoration-base-600 underline-offset-4 hover:text-base-200 hover:decoration-primary-400 active:text-base-200 active:decoration-primary-400 before:absolute before:-inset-x-1 before:-inset-y-2.5 before:content-['']"
        >Privacy</a
      >
    </div>
  </div>
</footer>

---
import BackgroundItem from '@components/Background/BackgroundItem.astro';
import backgroundData from '@config/backgroundData.json';
import Academic from '@components/Icons/Academic.astro';
---

<section id="background" class="w-full" data-aos="fade-up">
  <!-- The whole container, like Projects: the year column then costs the titles nothing. -->
  <div class="container pt-24 md:pt-36 lg:pt-44">
    <div class="mx-auto max-w-lg md:max-w-full">
      <h2 class="h2 flex items-center">
        <Academic class="mr-2 size-10 description" />
        <span>Academic <span class="text-gradient">background.</span></span>
      </h2>
      <!-- role="list": Safari drops the list semantics of a list without markers. -->
      <ol role="list" class="mt-10">
        {
          backgroundData.map((backgroundItem, index) => (
            <BackgroundItem {...backgroundItem} index={index} initialOpen={index === 0} />
          ))
        }
      </ol>
    </div>
  </div>
</section>

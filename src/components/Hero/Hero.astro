---
import { Image } from 'astro:assets';
import heroImage from '@assets/images/asier-ortiz.webp';
import siteData from '@config/siteData.json';
---

<section id="hero" class="hero-enter relative flex w-full z-[25]">
  <div class="container grid items-center gap-10 pt-24 md:pt-36 lg:pt-44 md:grid-cols-3 md:gap-20">
    <div class="mx-auto max-w-lg md:col-span-2 md:ml-0 md:max-w-full">
      <h1 class="h1">Hey, I'm <span class="text-gradient">{siteData.author.name}</span></h1>
      <p class="description mt-6">
        Full-stack and data developer with
        <span class="description font-semibold text-primary-300">
          5+ years of experience
        </span>
        building web and mobile products, from concept to production.
      </p>
    </div>
    <div class="mx-auto max-w-sm md:col-span-1 md:max-w-full">
      <div class="eclipse-wrapper aspect-square relative z-[25]">
        <div class="eclipse-ring"></div>
        <div class="overflow-hidden rounded-full">
          <Image
            id="hero-portrait"
            src={heroImage}
            class="w-full object-cover rounded-full"
            alt="Portrait of Asier Ortiz"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
            width={640}
            widths={[160, 320, 480, 640]}
            sizes="(min-width: 1200px) 280px, (min-width: 768px) 20vw, 40vw"
            oncontextmenu="return false"
          />
          <!-- Runs while the HTML is parsed, before the first paint. A portrait that is already
               available is never hidden; only one still in flight gets the fade-in on arrival. -->
          <script is:inline>
            (() => {
              const img = document.getElementById('hero-portrait');
              if (!img || img.complete) return;
              img.classList.add('fade-in');
              const reveal = () => img.classList.add('loaded');
              img.addEventListener('load', reveal, { once: true });
              img.addEventListener('error', reveal, { once: true });
            })();
          </script>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  /* Entrance without hiding the content. The hero is the LCP element on phones: anything
     that starts at opacity 0 (the AOS fade-up, or a CSS fade) delays the LCP until the main
     thread is free again, measured at +0.8 s on a throttled phone. A slide alone keeps the
     motion cue while the text is painted, and counted, on the first frame. Same distance,
     duration and easing as the AOS fade-up (15px, 0.75s, easeOutCubic). */
  @media (prefers-reduced-motion: no-preference) {
    :global(body.use-animations) .hero-enter {
      animation: hero-enter 0.75s cubic-bezier(0.215, 0.61, 0.355, 1) both;
    }
  }

  @keyframes hero-enter {
    from {
      transform: translate3d(0, 15px, 0);
    }
    to {
      transform: none;
    }
  }

  .eclipse-wrapper {
    position: relative;
    border-radius: 50%;
  }

  .eclipse-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow:
      0 0 15px 3px rgba(var(--color-primary-600-rgb), 0.15),
      0 0 35px 8px rgba(var(--color-primary-600-rgb), 0.08),
      0 0 60px 15px rgba(var(--color-primary-600-rgb), 0.04);
    animation: corona-breathe 5s ease-in-out infinite;
  }

  @keyframes corona-breathe {
    0%, 100% {
      box-shadow:
        0 0 15px 3px rgba(var(--color-primary-600-rgb), 0.15),
        0 0 35px 8px rgba(var(--color-primary-600-rgb), 0.08),
        0 0 60px 15px rgba(var(--color-primary-600-rgb), 0.04);
    }
    50% {
      box-shadow:
        0 0 20px 5px rgba(var(--color-primary-600-rgb), 0.22),
        0 0 45px 12px rgba(var(--color-primary-600-rgb), 0.12),
        0 0 70px 20px rgba(var(--color-primary-600-rgb), 0.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Keep the static glow (base box-shadow above); only stop the breathing. */
    .eclipse-ring {
      animation: none;
    }
  }

  /* Large desktops and monitors */
  @media (min-width: 1200px) {
    #hero .max-w-sm {
      max-width: 100%;
    }
  }

  /* Tablets in landscape mode */
  @media (max-width: 1199px) and (min-width: 992px) {
    #hero .max-w-sm {
      max-width: 70%;
    }
  }

  /* Tablets in portrait mode and small desktops */
  @media (max-width: 991px) and (min-width: 768px) {
    #hero .max-w-sm {
      max-width: 70%;
    }
  }

  /* Smartphones in landscape mode */
  @media (max-width: 767px) and (min-width: 576px) {
    #hero .max-w-sm {
      max-width: 40%;
    }
  }

  /* Smartphones in portrait mode */
  @media (max-width: 575px) {
    #hero .max-w-sm {
      max-width: 40%;
    }
  }
</style>

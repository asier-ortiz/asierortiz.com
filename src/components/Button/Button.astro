---
import { Icon } from 'astro-icon/components';

interface Props {
  type?: 'button' | 'submit' | 'reset' | null | undefined;
  variant?: 'primary' | 'secondary' | 'ghost' | 'post-ghost' | 'link';
  href?: URL | string;
  arrow?: 'left' | 'right' | 'none';
  onclick?: any;
  class?: string;
  target?: string;
  'aria-label'?: string;
  rest?: any;
}

const {
  type,
  variant = 'primary',
  href,
  arrow = 'none',
  onclick,
  class: className,
  ...rest
} = Astro.props as Props;

// A link that opens a new tab says so to screen readers (WCAG technique G201): at the end of its
// aria-label when it has one, otherwise after its visible words.
const NEW_TAB = ' (opens in a new tab)';
const newTab = rest.target === '_blank';
if (newTab && rest['aria-label']) rest['aria-label'] += NEW_TAB;
---

{
  href && (
    <a
      class:list={[
        className,
        `button group`,
        {
          'button--primary': variant === 'primary',
        },
        {
          'button--secondary': variant === 'secondary',
        },
        {
          'button--ghost': variant === 'ghost',
        },
        {
          'button--post-ghost': variant === 'post-ghost',
        },
        {
          'button--link': variant === 'link',
        },
      ]}
      href={href}
      onclick={onclick}
      {...rest}
    >
      {arrow === 'left' && (
        <Icon
          name="tdesign:arrow-left"
          class="h-6 w-6 transition-[transform] motion-safe:group-hover:-translate-x-1 mr-2"
          aria-hidden="true"
        />
      )}
      <slot />
      {newTab && !rest['aria-label'] && <span class="sr-only">{NEW_TAB}</span>}
      {arrow === 'right' && (
        <Icon
          name="tdesign:arrow-right"
          class="h-6 w-6 transition-[transform] motion-safe:group-hover:translate-x-1 ml-2"
          aria-hidden="true"
        />
      )}
    </a>
  )
}

{
  !href && (
    <button
      class:list={[
        className,
        `button group`,
        {
          'button--primary': variant === 'primary',
        },
        {
          'button--secondary': variant === 'secondary',
        },
        {
          'button--ghost': variant === 'ghost',
        },
        {
          'button--post-ghost': variant === 'post-ghost',
        },
        {
          'button--link': variant === 'link',
        },
      ]}
      type={type}
      onclick={onclick}
      {...rest}
    >
      {arrow === 'left' && (
        <Icon
          name="tdesign:arrow-left"
          class="h-6 w-6 transition-[transform] motion-safe:group-hover:-translate-x-1 mr-2"
          aria-hidden="true"
        />
      )}
      <slot />
      {arrow === 'right' && (
        <Icon
          name="tdesign:arrow-right"
          class="h-6 w-6 transition-[transform] motion-safe:group-hover:translate-x-1 ml-2"
          aria-hidden="true"
        />
      )}
    </button>
  )
}

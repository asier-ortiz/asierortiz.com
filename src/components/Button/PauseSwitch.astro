---
import { Icon } from 'astro-icon/components';

interface Props {
  /** Must be unique per page: the label points at the switch through it. */
  id: string;
  /** Screen reader name of the switch; on means paused. */
  label?: string;
  /**
   * 'overlay' adds a dark backdrop, for a switch drawn on top of an image. 'floating' is a
   * page-level button in the scroll-to-top button's family, fixed in place by the caller.
   */
  variant?: 'plain' | 'overlay' | 'floating';
  class?: string;
  rest?: any;
}

const {
  id,
  label = 'Pause animation',
  variant = 'plain',
  class: className,
  ...rest
} = Astro.props as Props;

// The floating one takes the scroll-to-top button's shape at a smaller size, with a grey border
// rather than its blue one: always on screen, it must not pull the eye like an action does.
const variants = {
  plain: {
    toggle: 'size-7 text-base-500 hover:text-base-200 active:bg-base-800 active:text-base-200',
    icon: 'size-4',
  },
  overlay: {
    toggle:
      'size-7 bg-base-950/70 text-base-200 hover:text-white active:bg-base-800 active:text-white',
    icon: 'size-4',
  },
  floating: {
    toggle:
      'size-10 border-2 border-base-600 bg-base-800 text-base-300 shadow-md hover:border-base-400 hover:text-base-100 active:bg-base-700 active:text-base-100',
    icon: 'size-5',
  },
};
const { toggle, icon } = variants[variant];
---

<!--
  A checkbox with role="switch" (checked = paused), so the state is exposed natively and CSS or
  a script can read it. The label draws the control at 28px (40px floating); its ::before
  stretches the tap area 6px further on each side. Hidden under reduced motion, where nothing
  moves.
-->
<div class:list={['pause-switch', className]} {...rest}>
  <input id={id} type="checkbox" role="switch" class="pause-switch__input sr-only" />
  <label
    for={id}
    class:list={[
      "pause-switch__toggle relative grid cursor-pointer place-items-center rounded-full transition-colors duration-300 active:duration-0 before:absolute before:-inset-1.5 before:content-['']",
      toggle,
    ]}
  >
    <Icon name="tdesign:pause" class={`pause-switch__icon-pause ${icon}`} aria-hidden="true" />
    <Icon name="tdesign:play" class={`pause-switch__icon-play hidden ${icon}`} aria-hidden="true" />
    <span class="sr-only">{label}</span>
  </label>
</div>

<style lang="scss">
  .pause-switch__input:checked + .pause-switch__toggle {
    .pause-switch__icon-pause {
      display: none;
    }

    .pause-switch__icon-play {
      display: block;
    }
  }

  .pause-switch__input:focus-visible + .pause-switch__toggle {
    @apply outline-none ring-2 ring-primary-500 ring-offset-2 ring-offset-base-950;
  }

  @media (prefers-reduced-motion: reduce) {
    .pause-switch {
      display: none;
    }
  }
</style>

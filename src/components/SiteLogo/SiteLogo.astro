---
import siteData from '@config/siteData.json';
---

<a
  class="primary-focus group/navlink py-2 text-xl"
  href="/"
  data-section="hero"
  onclick="if (location.pathname === '/' && location.hash === '#hero') { event.preventDefault(); window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); }"
>
  <span class="navlink__underline-ltr inline">
    {siteData.author.name}
  </span>
</a>

<style lang="scss">
  .navlink__underline-ltr {
    @apply bg-gradient-to-r from-primary-600 to-primary-600 bg-[length:0%_2px] bg-left-bottom bg-no-repeat transition-[background-size] duration-300 group-hover/navlink:bg-[length:100%_2px];
  }

  .active-navlink {
    @apply bg-[length:100%_2px];
  }

  /* Tapped, while the next page loads (Layout.astro): full underline and brighter text, so it reads
     apart from the current page's underline. Instant, as iOS freezes transitions then. */
  a[data-pressed] .navlink__underline-ltr {
    @apply bg-[length:100%_2px] text-primary-400 duration-0;
  }
</style>

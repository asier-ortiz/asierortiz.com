---
import type { CollectionEntry } from 'astro:content';
import PostImage from '@/components/Media/PostImage.astro';
import SearchButton from '@components/Blog/SearchButton.vue';
import Pagination from '@components/Blog/Pagination.astro';
import Button from '@/components/Button/Button.astro';
import siteData from '@config/siteData.json';
import { getReadingTime } from '@/utils/readingTime';
import { formatDate } from '@/utils/formatDate';
import type { PaginationInfo } from '@/utils/posts';

type Post = CollectionEntry<'blog'>;

interface Props {
  /** Every published post: feeds the search index and the tag chips. */
  allPosts: Post[];
  /** The posts rendered on this page. */
  posts: Post[];
  pagination?: PaginationInfo;
  /** Set on /blog/tag/<tag>/ pages. */
  activeTag?: string;
}

const { allPosts, posts, pagination, activeTag } = Astro.props;

// Chips are ordered by how many posts they group, so the themes of the blog come first.
const tagCounts = new Map<string, number>();
for (const tag of allPosts.flatMap((post) => post.data.tags)) {
  tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const allTags = [...tagCounts.keys()].sort(
  (a, b) => tagCounts.get(b)! - tagCounts.get(a)! || a.localeCompare(b)
);

// Progressive disclosure: the first chips are always visible, the rest sit behind a
// "More tags" button. A couple of extras are not worth a button, and the active tag is
// never hidden.
const VISIBLE_TAGS = 8;
const collapsed = allTags.length > VISIBLE_TAGS + 2;
const isHidden = (tag: string, index: number) => collapsed && index >= VISIBLE_TAGS && tag !== activeTag;
const hiddenCount = allTags.filter(isHidden).length;

// Chips are links to the tag pages, so filtering works without JavaScript and every
// filter has a URL. When this page holds every post, a script enhances the same links to
// filter the grid in place and push that URL, instead of navigating.
const filterable = posts.length === allPosts.length;

const searchIndex = allPosts.map((post) => ({
  title: post.data.title || '',
  description: post.data.description || '',
  url: `/blog/${post.slug}/`,
  pubDate: post.data.pubDate,
  tags: post.data.tags ?? [],
}));
---

<section class="mx-auto max-w-3xl px-6 pt-24 md:pt-36 lg:pt-44">
  <header class="blog-header text-left mb-12">
    <h1 class="h1 text-pretty text-gradient pb-2">{siteData.blog.title}</h1>
    <p class="description mt-6 text-pretty">
      {siteData.blog.description}
      <Button
        variant="link"
        href={siteData.newsletter.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={siteData.newsletter.label}
        class="inline"
      >
        Get them by email.
      </Button>
    </p>
  </header>

  <!-- Search Button & Tag Filter Buttons -->
  {
    allTags.length > 0 && (
      <div
        id="tag-filters"
        class="blog-filters flex flex-wrap gap-2 mb-6 items-center p-1"
        data-filterable={filterable ? '' : undefined}
      >
        <SearchButton client:load posts={searchIndex} language={siteData.language} />

        <a
          href="/blog/"
          class:list={['button button--chip', { 'button--chip-active': !activeTag }]}
          aria-current={!activeTag ? 'page' : undefined}
          data-tag="all"
        >
          All
        </a>
        {allTags.map((tag, index) => (
          <a
            href={`/blog/tag/${tag}/`}
            class:list={['button button--chip', { 'button--chip-active': activeTag === tag, hidden: isHidden(tag, index) }]}
            aria-current={activeTag === tag ? 'page' : undefined}
            data-tag={tag}
            data-tag-extra={isHidden(tag, index) ? '' : undefined}
          >
            #{tag}
          </a>
        ))}
        {collapsed && (
          <button
            type="button"
            id="tag-filters-more"
            class="button button--chip button--chip-muted"
            aria-expanded="false"
            aria-controls="tag-filters"
          >
            More tags (+{hiddenCount})
          </button>
        )}
      </div>
    )
  }

  <p id="tag-filters-status" class="text-sm text-base-400 mb-6" role="status">
    {
      activeTag
        ? `${posts.length} ${posts.length === 1 ? 'post' : 'posts'} tagged #${activeTag}`
        : pagination && pagination.currentPage > 1
          ? `Page ${pagination.currentPage} of ${pagination.lastPage}`
          : ''
    }
  </p>

  <!-- Posts List -->
  <div id="posts-grid" class="grid gap-10 grid-cols-1 md:grid-cols-2">
    {
      posts.map((post, index) => {
        const readingDuration = getReadingTime(post.body);
        return (
          <a
            href={`/blog/${post.slug}/`}
            class="post-card group block overflow-hidden rounded-2xl border border-base-700 bg-base-900 hover:border-primary-500 hover:shadow-xl hover:scale-[1.02] transform transition-all duration-300"
            data-tags={post.data.tags?.join(',')}
          >
            <PostImage src={post.data.image} alt="" variant="card" priority={index === 0} />

            <div class="p-6">
              <h2 class="text-2xl font-semibold mb-2 underline-ltr">{post.data.title}</h2>

              <div class="flex flex-wrap items-center gap-2 text-base-400 text-sm mb-4">
                <time
                  datetime={post.data.pubDate.toISOString()}
                  data-relative-limit="7"
                  title={formatDate(post.data.pubDate, siteData.language)}
                >
                  {formatDate(post.data.pubDate, siteData.language)}
                </time>
                <span>·</span>
                <span>{readingDuration}</span>
                {post.data.author && (
                  <>
                    <span>·</span>
                    <span>By {post.data.author}</span>
                  </>
                )}
              </div>

              {post.data.tags && (
                <div class="flex flex-wrap gap-2 mb-4">
                  {post.data.tags.map((tag) => (
                    <span class="bg-primary-100 text-primary-800 text-xs px-2 py-1 rounded-full">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}

              <p class="description text-base-300 line-clamp-3">{post.data.description}</p>
            </div>
          </a>
        );
      })
    }
  </div>

  <Pagination pagination={pagination} />

  <script>
    document.querySelectorAll<HTMLTimeElement>('time[data-relative-limit]').forEach((el) => {
      const date = new Date(el.dateTime);
      const limit = parseInt(el.dataset.relativeLimit || '7');
      const diffMs = Date.now() - date.getTime();
      const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

      if (diffDays <= limit) {
        const rtf = new Intl.RelativeTimeFormat(document.documentElement.lang || 'en', {
          numeric: 'auto',
        });

        if (diffDays > 0) {
          el.textContent = rtf.format(-diffDays, 'day');
        } else {
          const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
          if (diffHours > 0) {
            el.textContent = rtf.format(-diffHours, 'hour');
          } else {
            const diffMinutes = Math.max(1, Math.floor(diffMs / (1000 * 60)));
            el.textContent = rtf.format(-diffMinutes, 'minute');
          }
        }
      }
    });
  </script>

  <!-- "More tags" / "Fewer tags": a filter row is a control, so it folds back as well -->
  <script>
    const moreButton = document.getElementById('tag-filters-more');
    if (moreButton) {
      const extras = document.querySelectorAll<HTMLElement>('#tag-filters [data-tag-extra]');
      const moreLabel = moreButton.textContent;
      moreButton.addEventListener('click', () => {
        const expand = moreButton.getAttribute('aria-expanded') !== 'true';
        // A selected tag stays visible when folding, so the active filter is never hidden.
        extras.forEach((chip) => {
          const active = chip.classList.contains('button--chip-active') || chip.hasAttribute('aria-current');
          chip.classList.toggle('hidden', !expand && !active);
        });
        moreButton.setAttribute('aria-expanded', String(expand));
        moreButton.textContent = expand ? 'Fewer tags' : moreLabel;
        if (expand) extras[0]?.focus();
      });
    }
  </script>

  <!-- In-page filtering when every post is on this page: the chip links filter the grid
       and push their URL (a real tag page), so the filter survives reload, back and sharing.
       Clicking the active tag deselects it. -->
  <script>
    const filters = document.getElementById('tag-filters');
    if (filters?.hasAttribute('data-filterable')) {
      const chips = [...filters.querySelectorAll<HTMLAnchorElement>('a[data-tag]')];
      const cards = [...document.querySelectorAll<HTMLElement>('#posts-grid .post-card')];
      const status = document.getElementById('tag-filters-status');

      const tagFromPath = (path: string) => path.match(/^\/blog\/tag\/([^/]+)\/?$/)?.[1] ?? 'all';

      const apply = (tag: string) => {
        let shown = 0;
        cards.forEach((card) => {
          const match = tag === 'all' || (card.dataset.tags ?? '').split(',').includes(tag);
          card.style.display = match ? '' : 'none';
          if (match) shown++;
        });
        chips.forEach((chip) => {
          const active = chip.dataset.tag === tag;
          chip.classList.toggle('button--chip-active', active);
          if (active) chip.setAttribute('aria-current', 'page');
          else chip.removeAttribute('aria-current');
        });
        if (status) status.textContent = tag === 'all' ? '' : `${shown} ${shown === 1 ? 'post' : 'posts'} tagged #${tag}`;
      };

      chips.forEach((chip) =>
        chip.addEventListener('click', (event) => {
          const modified = event.metaKey || event.ctrlKey || event.shiftKey || event.altKey;
          if (event.defaultPrevented || event.button !== 0 || modified) return;
          event.preventDefault();
          const tag = chip.dataset.tag ?? 'all';
          const next = tag !== 'all' && chip.getAttribute('aria-current') === 'page' ? 'all' : tag;
          const url = next === 'all' ? '/blog/' : `/blog/tag/${next}/`;
          if (location.pathname !== url) history.pushState({ tag: next }, '', url);
          apply(next);
        })
      );

      window.addEventListener('popstate', () => apply(tagFromPath(location.pathname)));
      apply(tagFromPath(location.pathname));
    }
  </script>
</section>

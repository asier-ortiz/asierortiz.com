---
interface Section {
  id: string;
  title: string;
}

const { sections } = Astro.props as { sections: Section[] };
---

<!-- Named because posts hold a second complementary region, the newsletter box (PostFooterCta):
     a screen reader's list of regions can then tell the two apart. -->
<aside
  aria-label="Table of contents"
  class="fixed left-4 top-1/2 -translate-y-1/2 z-[50] hidden lg:block"
>
  <div id="toc-wrapper" class="relative">

    <!-- Compact mode. aria-expanded is the one open/closed state: the panel after it reads it
         through peer-aria-expanded. Fixed width, so the longer active bullet never resizes it. -->
    <button
      id="toc-toggle"
      aria-label="Table of contents"
      aria-controls="toc-panel"
      aria-expanded="false"
      class="peer flex w-10 flex-col gap-2 items-center p-2 bg-base-900 border border-base-500 rounded-md shadow hover:ring-2 hover:ring-primary-400 hover:ring-opacity-50 hover:shadow-lg hover:shadow-primary-400/50 active:ring-2 active:ring-primary-400 active:duration-0 transition-all duration-300"
    >
      {/* The current section's bullet is longer as well as blue, so it does not rely on colour. */}
      {sections.map(({ id }) => (
        <span
          class="scrollspy-bullet h-0.5 w-3 rounded-sm bg-base-500 transition-[background-color,width] duration-300 motion-reduce:transition-none data-[active]:w-5 data-[active]:bg-primary-400"
          data-target={id}
        ></span>
      ))}
    </button>

    <!-- Expanded mode. Closed, visibility: hidden takes its links out of the tab order and the
         accessibility tree (aria-hidden alone left them focusable while unseen); visibility flips
         at the end of the fade-out. inert would do it too, but needs Safari 15.5. The zoom-in only
         plays where motion is welcome. -->
    <div
      id="toc-panel"
      class="invisible absolute left-12 top-1/2 -translate-y-1/2 max-h-[75vh] overflow-y-auto bg-base-900 border border-base-700 rounded-xl p-4 shadow-2xl w-60 opacity-0 pointer-events-none motion-safe:scale-95 transition-[opacity,transform,visibility] duration-300 peer-aria-expanded:visible peer-aria-expanded:opacity-100 peer-aria-expanded:pointer-events-auto motion-safe:peer-aria-expanded:scale-100"
    >
      <h2 id="toc-heading" class="mb-4 text-xs font-bold tracking-wide uppercase text-base-400">
        Contents
      </h2>
      <nav id="scrollspy-nav" aria-labelledby="toc-heading" class="flex flex-col gap-1">
        {/* The current section takes a bar as well as a colour (aria-current drives both). The
            bar sits in the panel's padding (-ml-3 = border + pl-2.5), so the titles keep their
            width and wrap as they did without it; the transparent border holds every link still. */}
        {sections.map(({ id, title }) => (
          <a
            href={`#${id}`}
            class="scrollspy-link group -ml-3 border-l-2 border-transparent py-1.5 pl-2.5 text-sm text-base-400 hover:text-primary-400 transition-colors aria-[current=location]:border-primary-400 aria-[current=location]:text-primary-300"
            data-target={id}
          >
            {title}
          </a>
        ))}
      </nav>
    </div>
  </div>
</aside>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const compactBullets = document.querySelectorAll('#toc-toggle .scrollspy-bullet');
    const expandedLinks = document.querySelectorAll('#scrollspy-nav .scrollspy-link');
    const targets = Array.from(compactBullets).map(el => document.getElementById(el.dataset.target));
    const tocWrapper = document.getElementById('toc-wrapper');
    const tocToggle = document.getElementById('toc-toggle');
    const tocPanel = document.getElementById('toc-panel');

    // One current section at a time: the last whose heading has passed the reading line, a third
    // of the way down the window but no more than 300px (a third of a laptop's). On a tall window
    // a third would reach past a short section the reader has just jumped to, which lands 96px
    // down (scroll-padding-top), onto the next heading. At the bottom of the page the closing
    // headings can stay below the line: there the section is the one the reader jumped to, if it
    // is on screen, else the last one.
    function updateHighlight() {
      const line = window.scrollY + Math.min(window.innerHeight / 3, 300);
      const atBottom =
        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 5;

      let current = -1;
      targets.forEach((el, i) => {
        if (el && el.offsetTop <= line) current = i;
      });
      if (atBottom) {
        const jumped = targets.findIndex((el) => el?.matches(':target'));
        current = jumped >= 0 && jumped >= current ? jumped : targets.length - 1;
      }

      targets.forEach((_, i) => {
        const isActive = i === current;
        compactBullets[i]?.toggleAttribute('data-active', isActive);

        const link = expandedLinks[i];
        if (isActive) link?.setAttribute('aria-current', 'location');
        else link?.removeAttribute('aria-current');
      });
    }

    document.addEventListener('scroll', updateHighlight);
    // At the bottom of the page, a jump between two headings already on screen scrolls nothing.
    window.addEventListener('hashchange', updateHighlight);
    updateHighlight();

    const isOpen = () => tocToggle.getAttribute('aria-expanded') === 'true';
    const setOpen = (open) => tocToggle.setAttribute('aria-expanded', String(open));

    tocToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(!isOpen());
    });

    document.addEventListener('click', (e) => {
      if (isOpen() && !tocWrapper.contains(e.target)) setOpen(false);
    });

    // Escape closes it, and focus inside the panel goes back to the button instead of staying on
    // a link that is about to hide.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !isOpen()) return;
      if (tocPanel.contains(document.activeElement)) tocToggle.focus();
      setOpen(false);
    });
  });
</script>

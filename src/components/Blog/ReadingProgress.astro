<!-- Scaled with transform rather than resized, so the update never triggers layout. No transition:
     the bar follows the scroll itself; a timed one trailed it and restarted on every scroll event,
     which stuttered on iPhone. -->
<div id="reading-progress" class="fixed left-0 z-20 h-[4px] w-full origin-left scale-x-0 bg-gradient-to-r from-primary-600 to-primary-600"></div>

<script is:inline>
  if (typeof window !== 'undefined') {
    const progressBar = document.getElementById('reading-progress');
    const nav = document.getElementById('nav__container');

    const updateReadingProgress = () => {
      // The bar's own container: the post's column, the article and what follows it.
      const column = progressBar?.parentElement;
      if (!progressBar || !column || !nav) return;

      const navBottom = nav.offsetTop + nav.offsetHeight;
      progressBar.style.top = `${navBottom}px`;

      const totalHeight = column.scrollHeight - window.innerHeight;
      const scrolled = window.scrollY - column.offsetTop;
      const percentage = Math.max(0, Math.min((scrolled / totalHeight) * 100, 100));
      progressBar.style.transform = `scaleX(${percentage / 100})`;
    };

    window.addEventListener('scroll', updateReadingProgress);
    window.addEventListener('resize', updateReadingProgress);
    window.addEventListener('load', updateReadingProgress);
  }
</script>

<!-- Same background layer as the star field (Particles.vue): stars cross the sky behind the
     content, so screenshots, cards and text cover them instead of being crossed by them. The one
     star of the sky's entrance is launched into it by sky-entrance.js. -->
<div id="shooting-stars-container" class="fixed inset-0 -z-10 pointer-events-none overflow-hidden hidden md:block"></div>

<style is:global>
  .shooting-star {
    position: absolute;
    width: 120px;
    height: 2px;
    background: linear-gradient(to right, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0));
    border-radius: 999px;
    opacity: 0;
    animation: shoot 0.8s ease-out forwards;
  }

  .shooting-star::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: white;
    box-shadow: 0 0 6px 2px rgba(255, 255, 255, 0.6);
  }

  @keyframes shoot {
    0% {
      opacity: 1;
      transform: rotate(var(--angle)) translateX(0);
    }
    100% {
      opacity: 0;
      transform: rotate(var(--angle)) translateX(300px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shooting-star {
      animation: none;
      display: none;
    }
  }
</style>

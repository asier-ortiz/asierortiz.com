---
import PauseSwitch from '@components/Button/PauseSwitch.astro';
---

<!--
  Pauses the star field and the shooting stars, which move with no end (WCAG 2.2.2). Mirrors the
  scroll-to-top button in the bottom-left corner, but comes first in the page so it is the first
  tab stop. Only from md, where the stars are drawn, and hidden until its script runs: without
  JavaScript nothing moves.
-->
<PauseSwitch
  id="particles-pause"
  label="Pause background animation"
  variant="floating"
  class="fixed bottom-12 left-6 z-20 max-md:hidden lg:bottom-16 lg:left-8 xl:bottom-20 xl:left-10"
  hidden
/>

<!-- Inline, so it runs while the page is parsed: a pause from an earlier page is back on before
     the stars start, with no moment of motion first. -->
<script is:inline>
  (function () {
    var pauseSwitch = document.getElementById('particles-pause');
    if (!pauseSwitch) return;

    // Stored only while paused, so a visitor who never pauses has nothing in their browser (see
    // the privacy page). Storage can throw (blocked site data, some private windows); the switch
    // then just starts off on every page.
    var key = 'particles-paused';
    try {
      pauseSwitch.checked = localStorage.getItem(key) === '1';
    } catch (e) {}

    pauseSwitch.addEventListener('change', function () {
      try {
        if (pauseSwitch.checked) localStorage.setItem(key, '1');
        else localStorage.removeItem(key);
      } catch (e) {}
    });

    pauseSwitch.closest('.pause-switch').removeAttribute('hidden');
  })();
</script>

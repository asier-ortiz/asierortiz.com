---
import PauseSwitch from '@components/Button/PauseSwitch.astro';
---

<!--
  Pauses the star field and the shooting stars, which move with no end (WCAG 2.2.2). Mirrors the
  scroll-to-top button in the bottom-left corner, but comes first in the page so it is the first
  tab stop. Only from md, where the stars are drawn, and hidden until its script runs: without
  JavaScript nothing moves.
-->
<PauseSwitch
  id="particles-pause"
  label="Pause background animation"
  variant="floating"
  class="fixed bottom-12 left-6 z-20 max-md:hidden lg:bottom-16 lg:left-8 xl:bottom-20 xl:left-10"
  hidden
/>

<script>
  document.getElementById('particles-pause')?.closest('.pause-switch')?.removeAttribute('hidden');
</script>

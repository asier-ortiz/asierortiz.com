---
import Layout from '@layouts/Layout.astro';
import Particles from '@components/Particles/Particles.vue';
import Button from '@components/Button/Button.astro';
import siteData from '@config/siteData.json';
---

<Layout title="Page not found" description="This page does not exist." noindex>
  <Particles client:media="(min-width: 768px)" />
  <section class="container pt-24 md:pt-36 lg:pt-44">
    <div class="w-full py-20 text-center md:py-32">
      <div class="mx-auto max-w-xl px-4 text-center">
        <h1 class="h1 text-gradient">404.</h1>
        <p class="description mt-4">
          There is nothing at this address. The page may have moved, or the link that brought you
          here may be wrong. If you followed a link from this site, tell me and I will fix it.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <Button variant="ghost" href="/">Go to homepage</Button>
          <Button variant="ghost" href="/blog/">Browse the blog</Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

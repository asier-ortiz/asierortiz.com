---
import Layout from '@layouts/Layout.astro';
import Particles from '@components/Particles/Particles.vue';
import StackMarquee from '@components/Stack/StackMarquee.astro';
import siteData from '@config/siteData.json';
import { development, setup } from '@config/usesData.json';
import stackData from '@config/stackData.json';
---

<Layout
  title="Tools & setup"
  description={`The tools and setup ${siteData.author.name} works with every day: editor, terminal, languages, services and hardware.`}
>
  <Particles client:media="(min-width: 768px)" />
  <!-- The home page's frame, as this is a page of the menu like Projects, Background and the blog:
       the title starts under the logo and, from lg, the labels and items of the lists fall on the
       years and titles of the Background timeline. The lists keep their reading width. The band
       takes the whole frame, so its faded edges end at the frame's, not in the middle of the page. -->
  <article class="container pt-24 md:pt-36 lg:pt-44">
    <header>
      <h1 class="h1 text-pretty text-gradient lg:pb-2">My tools and setup</h1>
      <p class="description mt-6 max-w-[42rem] text-pretty">
        The software I build with and the hardware I use every day.
      </p>
    </header>
    <StackMarquee items={stackData} class="mt-12" />
    <section class="prose mt-14">
      <h2 class="h3 text-pretty text-primary-500">Development</h2>
      <dl class="uses-list text-pretty">
        {
          development.map(({ title, items }) => (
            <div>
              <dt>{title}</dt>
              {/* Each name stays whole: a line breaks only after a comma, never inside "IntelliJ
                  IDEA" or after the hyphen of "scikit-learn". Not inline-block, which lets a line
                  break before the comma. An array rather than a fragment: Prettier splits a
                  fragment into lines, and Astro renders those line breaks as a space before each
                  comma. */}
              <dd>
                {items.map((item, i) => [
                  i > 0 && ', ',
                  <span class="whitespace-nowrap">{item}</span>,
                ])}
              </dd>
            </div>
          ))
        }
      </dl>
      <h2 class="h3 mt-16 text-pretty text-primary-500">Setup</h2>
      <dl class="uses-list text-pretty">
        {
          setup.map(({ title, items }) => (
            <div>
              <dt>{title}</dt>
              <dd>
                <ul role="list">
                  {items.map(({ name, details }) => (
                    <li>
                      {name}
                      {details && (
                        <span class="details">
                          <span aria-hidden="true">·</span>{' '}
                          {/* Kept whole like the names above, so "512 GB" never splits. */}
                          {details.map((detail, i) => [
                            i > 0 && ', ',
                            <span class="whitespace-nowrap">{detail}</span>,
                          ])}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </article>
</Layout>

<style>
  /* Each category sits beside its items from md and above them on phones, with a hairline between
     rows to carry the eye across. These rules outrank the typography plugin's dl, dd, ul and li
     styles, which are meant for definitions and bullets in running text. */
  .uses-list > div {
    @apply grid items-baseline gap-y-0.5 border-t border-base-800 py-3 md:grid-cols-[9.5rem_1fr] md:gap-x-6 md:py-3.5;
  }

  .uses-list > div:first-child {
    @apply border-t-0 pt-0;
  }

  /* A label, quieter than the items it introduces. */
  .uses-list dt {
    @apply m-0 font-sans text-sm font-medium text-base-400 md:text-[0.9375rem];
  }

  .uses-list dd {
    @apply m-0 p-0;
  }

  .uses-list ul {
    @apply m-0 list-none p-0;
  }

  /* A device that wraps indents its later lines, so a new one is always the line at the edge. */
  .uses-list li {
    @apply my-0 pl-[1em] -indent-[1em];
  }

  .details {
    @apply text-[0.9em] text-base-400;
  }
</style>

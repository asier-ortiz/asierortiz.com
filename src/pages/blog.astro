---
import Layout from '@layouts/Layout.astro';
import Particles from '@components/Particles/Particles.vue';
import BlogListing from '@components/Blog/BlogListing.astro';
import siteData from '@config/siteData.json';
import { getPublishedPostsSorted, paginationInfo, POSTS_PER_PAGE } from '@/utils/posts';

// Page 1 of the listing. Later pages live at /blog/page/<n>/.
const posts = await getPublishedPostsSorted();
const lastPage = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const pagination = paginationInfo(1, lastPage);
---

<Layout
  title={`${siteData.author.name} - Blog`}
  description="Posts about web, mobile and AI. Mostly notes from projects, things that broke, things I figured out along the way."
>
  <Particles client:only="vue" />
  <BlogListing allPosts={posts} posts={posts.slice(0, POSTS_PER_PAGE)} pagination={pagination} />
</Layout>

---
import type { CollectionEntry } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Particles from '@components/Particles/Particles.vue';
import BlogListing from '@components/Blog/BlogListing.astro';
import siteData from '@config/siteData.json';
import { getPublishedPostsSorted } from '@/utils/posts';

type Post = CollectionEntry<'blog'>;

// One page per tag, always: the chips in the listing link here, and the in-page filter
// pushes these URLs, so they have to resolve on reload and when shared.
export async function getStaticPaths() {
  const posts = await getPublishedPostsSorted();

  const tags = Array.from(new Set(posts.flatMap((post) => post.data.tags || [])));
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags?.includes(tag)),
      allPosts: posts,
    },
  }));
}

const { tag, posts, allPosts } = Astro.props as { tag: string; posts: Post[]; allPosts: Post[] };
---

<Layout
  title={`${siteData.author.name} - Blog - #${tag}`}
  description={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'} tagged #${tag} on ${siteData.author.name}'s blog: notes from real projects, things that broke, things I figured out along the way.`}
>
  <Particles client:media="(min-width: 768px)" />
  <BlogListing allPosts={allPosts} posts={posts} activeTag={tag} />
</Layout>

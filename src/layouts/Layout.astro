---
import '@/styles/global.scss';
// Self-hosted fonts (latin subsets, font-display: swap); nothing is fetched from Google.
// Poppins: headings, navigation, buttons and small UI text. Source Serif 4: reading text
// (descriptions and article prose), see .description and .prose in src/styles.
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/source-serif-4/latin-400.css';
import '@fontsource/source-serif-4/latin-400-italic.css';
import '@fontsource/source-serif-4/latin-600.css';
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2';
import poppins700 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2';
import serif400 from '@fontsource/source-serif-4/files/source-serif-4-latin-400-normal.woff2';
import Nav from '@components/Nav/Nav.astro';
import Footer from '@components/Footer/Footer.astro';
import ScrollToTop from '@components/Button/ScrollToTop.astro';
import ShootingStar from '@components/Particles/ShootingStar.astro';
import siteData from '@config/siteData.json';
import { absoluteUrl } from '@/utils/absoluteUrl';
import { backgroundColor } from '@/config/theme';
import type { ImageMetadata } from 'astro';

interface Props {
  /** What this page is, e.g. "Blog"; the site name is appended. The home page passes its full title. */
  title: string;
  bareTitle?: boolean;
  description: string;
  /** Share image; falls back to the site's default card. */
  image?: ImageMetadata;
  imageAlt?: string;
  pubDate?: Date | string;
  updatedDate?: Date | string;
  isPost?: boolean;
  /** Keep the page out of search results (confirmation and error pages). */
  noindex?: boolean;
}

const { title, bareTitle, description, image, imageAlt, pubDate, updatedDate, isPost, noindex } =
  Astro.props as Props;
const pageTitle = bareTitle ? title : `${title} · ${siteData.author.name}`;
const pageUrl = Astro.url;
const shareImage = image ?? siteData.defaultImage.src;
const shareImageAlt = imageAlt ?? siteData.defaultImage.alt;
const ogImage = absoluteUrl(shareImage.src, Astro.site);
const ogLocale = siteData.language.replace(/-(\w+)$/, (_, region) => `_${region.toUpperCase()}`);
const published = pubDate ? new Date(pubDate) : undefined;
const modified = updatedDate ? new Date(updatedDate) : undefined;
---

<!doctype html>
<html lang={siteData.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- /favicon.ico and /apple-touch-icon.png also exist at the site root for clients that
         request them blindly. The 192px icon is the one search engines pick for results. -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicons/android-chrome-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={backgroundColor} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl} />}

    <!-- RSS / JSON Feed alternate links -->
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title="JSON Feed" href="/feed.json" />

    <title>{pageTitle}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={isPost ? 'article' : 'website'} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta property="og:site_name" content={siteData.name} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={shareImageAlt} />

    <!-- Article meta for blog posts -->
    {
      isPost && published && (
        <>
          <meta property="article:published_time" content={published.toISOString()} />
          {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
          <meta property="article:author" content={siteData.author.name} />
        </>
      )
    }

    <!-- JSON-LD Structured Data -->
    {
      !isPost ? (
        <script type="application/ld+json" set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@graph': [
            {
              '@type': 'WebSite',
              name: siteData.name,
              url: Astro.site,
              description: siteData.description,
            },
            {
              '@type': 'Person',
              name: siteData.author.name,
              url: Astro.site,
              email: siteData.author.email,
              sameAs: siteData.socialLinks
                .filter((l) => l.platform !== 'email' && l.platform !== 'rss')
                .map((l) => l.link),
              jobTitle: 'Full-Stack & Data Developer',
            },
          ],
        })} />
      ) : (
        <script type="application/ld+json" set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'BlogPosting',
          headline: title,
          description: description,
          url: pageUrl,
          image: ogImage,
          datePublished: published?.toISOString(),
          dateModified: (modified ?? published)?.toISOString(),
          author: {
            '@type': 'Person',
            name: siteData.author.name,
            url: Astro.site,
          },
          publisher: {
            '@type': 'Person',
            name: siteData.author.name,
            url: Astro.site,
          },
        })} />
      )
    }

    <!-- Faces needed for the first paint (h1, nav, hero paragraph); the rest load on demand -->
    <link rel="preload" href={poppins700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serif400} as="font" type="font/woff2" crossorigin />
  </head>

  <body
    class:list={['dark overflow-y-scroll', { 'use-animations': siteData.useAnimations === true }]}
  >
    <div class="flex min-h-[100lvh] flex-col justify-between">
      <div>
        <Nav />
        <main>
          <slot />
        </main>
      </div>
      <Footer />
    </div>
    <ScrollToTop />
    {!isPost && <ShootingStar />}

    <!-- Initialize AOS animations if enabled in site config -->
    <script>
      import siteData from '@config/siteData.json';
      import AOS from '@js/aos/aos';

      if (siteData.useAnimations === true && typeof window !== 'undefined') {
        AOS.init({
          once: true,
          duration: 0.75,
          distance: 15,
          // When disabled, AOS strips the data-aos attributes, so the hide rules
          // in src/styles/aos.scss stop matching and content stays visible.
          // Evaluated once per full page load.
          disable: () => window.matchMedia('(prefers-reduced-motion: reduce)').matches,
        });
      }
    </script>


    <!-- Copy buttons for code blocks; bundled by Astro, one source for dev and production -->
    <script>
      import '@/scripts/copy-code.js';
    </script>

    <!-- Tapped links stay pressed until the next page loads; components style [data-pressed] -->
    <script>
      import '@/scripts/pressed-links.js';
    </script>

  </body>
</html>
